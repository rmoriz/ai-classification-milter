# /etc/ai-classification-milter.env — environment overrides for the milter service.
# Precedence: env var > ai-classification-milter.toml > built-in defaults.
#
# Install as: root:_ai-milter 0640  (contains the API key — never world-readable)
#   chown root:_ai-milter /etc/ai-classification-milter.env
#   chmod 640 /etc/ai-classification-milter.env
# Reload after changes: systemctl restart ai-classification-milter

# Where the TOML lives. Relative paths in the TOML resolve against the unit's
# WorkingDirectory (/var/lib/ai-classification-milter).
MILTER_CONFIG=/etc/ai-classification-milter.toml

# Secret — prefer env over the TOML.
OPENROUTER_API_KEY=sk-or-...

# Milter socket for Postfix (must match smtpd_milters in main.cf).
# MILTER_LISTEN=127.0.0.1:8891

# Model selection (comma-separated). Default = all 5 eval models.
# OPENROUTER_MODELS=microsoft/microsoft-decision-1,cloudflare/clef-omni,upstage/solar-decide-flash,nace-ai/drex-v1.5,typesafe/jev-1.13

# learn_mode=true tags + logs only; false rejects spam with 550 5.7.1.
# LEARN_MODE=true
# LOG_ALL_MAILS=false

# Whitelisted sender domains skip the models entirely (comma-separated).
# WHITELIST_SENDER_DOMAINS=example.com,dept.example.com

# Dashboard (own socket, plain HTTP — put it on a tailnet IP or 127.0.0.1).
# DASHBOARD_ENABLED=true
# DASHBOARD_LISTEN=127.0.0.1:8892
# DASHBOARD_TOKEN=change-me
# DASHBOARD_SCRAMBLE_SENDERS=true

RUST_LOG=info