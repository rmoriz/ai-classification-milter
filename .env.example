# ai-classification-milter env overrides (take precedence over ai-classification-milter.toml). Only set what differs.
# MILTER_CONFIG=./ai-classification-milter.toml
# MILTER_LISTEN=127.0.0.1:8891
# OPENROUTER_URL=https://openrouter.ai/api/alpha/decisions
# OPENROUTER_MODELS=microsoft/microsoft-decision-1,cloudflare/clef-omni,upstage/solar-decide-flash,nace-ai/drex-v1.5,typesafe/jev-1.13
OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_REFERER=https://example.com
# OPENROUTER_TITLE=ai-classification-milter
# QUESTION_INSTRUCTIONS=Is this mail spam, phishing or malicious?
# LLM_TIMEOUT_SECS=5
# SCORE_THRESHOLD=0.85
# DECISION=any
# LOG_ALL_MAILS=false
# LEARN_MODE=true
# WHITELIST_SENDER_DOMAINS=example.com,dept.example.com
RUST_LOG=info
